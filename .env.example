# Скопируйте этот файл в .env и заполните значения.
# Файл .env не попадает в git.

# Порт веб-сервера
PORT=3000

# Публичный адрес сайта без слэша в конце. Нужен для Open Graph,
# sitemap.xml и ссылки на админку в уведомлениях Telegram.
SITE_URL=http://localhost:3000

# Пароль (токен) для входа в /admin. Длинная случайная строка, минимум 16 символов.
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# Если не задан, админка отключена.
ADMIN_TOKEN=

# Уведомления о новых записях в Telegram (необязательно).
# Токен выдаёт @BotFather, chat_id можно узнать у @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Папка для файла с записями
DATA_DIR=./data

# Демо-режим: данные в памяти, тестовые записи, токен админки "demo",
# Telegram отключён, на сайте показывается плашка «демо».
DEMO_MODE=false

# Сколько прокси стоит перед приложением (Render, Nginx и т. п.).
# Нужно, чтобы ограничение частоты запросов видело настоящий IP клиента.
TRUST_PROXY=0

# Уровень логов: debug, info, warn, error, silent
LOG_LEVEL=info
